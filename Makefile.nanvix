#
# Usage: make -f Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_TOOLCHAIN=<sdk> [target]
#
# Targets:
#   all: Build SQLite library and CLI, then stage via install
#   install: Stage built artifacts into LIB_OUT/INCLUDE_OUT/BIN_OUT
#   test: Run functional tests
#   test-functional: Run SQL queries on nanvixd$(EXE)
#   clean: Remove build artifacts
#   distclean: Remove all generated files

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is ONLY called by z.py
# 2. Build mode ALWAYS runs in Docker
# 3. Build ALWAYS runs before test and release

.DEFAULT_GOAL=all
EXE = .elf
CONFIGURED_MARKER = .nanvix-configured
_NANVIX_DOCKER_BUILD_GOALS := all build install configure $(CONFIGURED_MARKER)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined
_REQUIRED := PLATFORM \
    PROCESS_MODE \
    MEMORY_SIZE \
    NANVIX_HOME \
    NANVIX_TOOLCHAIN \
    NANVIX_ROOT \
    OUT_DIR \
    DIST_DIR \
    LIB_OUT \
    INCLUDE_OUT \
    BIN_OUT
ifneq ($(filter-out clean distclean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH := $(abspath $(NANVIX_HOME))
PREFIX ?= $(SYSROOT_PATH)
INSTALL_PREFIX ?= $(SYSROOT_PATH)

# Artifacts staged by `install` into the release/test output tree so that
# `./z release` (which packages release_dir()) can find them.
LIB_ARTIFACTS     := libsqlite3.a
INCLUDE_ARTIFACTS := sqlite3.h src/sqlite3ext.h
BIN_ARTIFACTS     := sqlite3$(EXE)

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  # Error out if mixing build and non-build goals
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/nanvix-sdk.json),)
      $(error Nanvix SDK not found at $(NANVIX_TOOLCHAIN))
  endif
  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/clang),)
      $(error Nanvix SDK Clang not found at $(NANVIX_TOOLCHAIN)/bin/clang)
  endif
endif

TOOLCHAIN_PREFIX := $(NANVIX_TOOLCHAIN)

CONFIGURE_ENV = \
AR="$(TOOLCHAIN_PREFIX)/bin/llvm-ar" \
AS="$(TOOLCHAIN_PREFIX)/bin/clang" \
CC="$(TOOLCHAIN_PREFIX)/bin/clang" \
CXX="$(TOOLCHAIN_PREFIX)/bin/clang++" \
CPP="$(TOOLCHAIN_PREFIX)/bin/clang-cpp" \
LD="$(TOOLCHAIN_PREFIX)/bin/clang" \
RANLIB="$(TOOLCHAIN_PREFIX)/bin/llvm-ranlib" \
NM="$(TOOLCHAIN_PREFIX)/bin/llvm-nm" \
STRIP="$(TOOLCHAIN_PREFIX)/bin/llvm-strip" \
CFLAGS="-I$(SYSROOT_PATH)/include -DSQLITE_OMIT_WAL=1" \
LDFLAGS="-L$(SYSROOT_PATH)/lib -Wl,-z,noexecstack" \
LIBS="-lz"

CONFIGURE_OPTS = \
--disable-shared \
--prefix="$(INSTALL_PREFIX)" \
--host=i686-nanvix \
--disable-tcl \
--disable-threadsafe \
--disable-load-extension

# When a pre-built jimsh0 exists (built on the host for the minimal
# Docker image), propagate B.tclsh=./jimsh0 to all sub-make invocations.
BTCLSH_OVERRIDE = $(if $(wildcard jimsh0),B.tclsh=./jimsh0)

# ===========================================================================
# Build Targets
# ===========================================================================

all: build install

configure: $(CONFIGURED_MARKER)

$(CONFIGURED_MARKER):
	@if [ -x jimsh0 ]; then \
	  $(CONFIGURE_ENV) ./configure $(CONFIGURE_OPTS) --with-tclsh=./jimsh0; \
	else \
	  $(CONFIGURE_ENV) ./configure $(CONFIGURE_OPTS); \
	fi
	touch $(CONFIGURED_MARKER)

build: $(CONFIGURED_MARKER)
	make -j$$(nproc) $(BTCLSH_OVERRIDE) all
	@if [ -f sqlite3 ] && [ ! -f sqlite3$(EXE) ]; then mv sqlite3 sqlite3$(EXE); fi

# Stage built artifacts into the release/test output tree so that
# `./z release` (which packages release_dir()) can find them.
install: build
	@mkdir -p $(LIB_OUT) $(INCLUDE_OUT) $(BIN_OUT)
	install -m 644 $(LIB_ARTIFACTS)     $(LIB_OUT)/
	install -m 644 $(INCLUDE_ARTIFACTS) $(INCLUDE_OUT)/
	install -m 755 $(BIN_ARTIFACTS)     $(BIN_OUT)/

# ===========================================================================
# Test Targets
# ===========================================================================

# --- Functional tests: run SQL queries on nanvixd$(EXE) ---
test-functional:
	@echo "=== SQLite functional tests ==="
	@echo "  NOTE: Standalone functional tests are handled via ./z.sh."
	@echo "  Delegating to: ./z.sh test test-functional"
	@PLATFORM="$(PLATFORM)" PROCESS_MODE="$(PROCESS_MODE)" MEMORY_SIZE="$(MEMORY_SIZE)" \
		./z.sh --with-nanvix "$(NANVIX_HOME)" test test-functional
	@echo "  PASS: SQLite functional tests"

# --- Run all test levels ---
test: test-functional
	@echo "=== All SQLite tests PASSED ==="

# ===========================================================================
# Clean
# ===========================================================================
clean:
	-make clean 2>/dev/null || true
	rm -f $(CONFIGURED_MARKER) sqlite3$(EXE) jimsh0 lemon mksourceid mkkeywordhash srcck1 src-verify lempar.c
	rm -rf $(OUT_DIR) dist/

distclean: clean
	-make distclean 2>/dev/null || true
	git clean -fdx -e Makefile.nanvix -e NANVIX.md -e .github -e nanvix-artifacts 2>/dev/null || true

.PHONY: all configure build install clean distclean test test-functional
